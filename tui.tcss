Screen {
    background: #0f172a;
}

#main-container {
    height: 100%;
    width: 100%;
}

#chat-panel {
    width: 65%;
    height: 100%;
    border: solid #0ea5e9;
    background: #1e293b;
    padding: 1;
}

#work-panel {
    width: 35%;
    height: 100%;
    border: solid #10b981;
    background: #0f172a;
    padding: 0 1;
}

#chat-title, #work-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    background: #334155;
    margin-bottom: 0;
    color: #f8fafc;
}

#chat-content, #work-content {
    width: 100%;
    height: 1fr;
}

.message-role {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    padding-left: 1;
}

.message-content {
    padding: 1 2;
    margin-bottom: 1;
}

/* User Message Styling */
.role-user.message-role {
    color: #10b981; /* Emerald */
}
.role-user.message-content {
    border-left: thick #10b981;
    background: #064e3b;
    color: #ecfdf5;
}

/* Assistant Message Styling */
.role-assistant.message-role {
    color: #0ea5e9; /* Sky blue */
}
.role-assistant.message-content {
    border-left: thick #0ea5e9;
    background: #0c4a6e;
    color: #e0f2fe;
}

/* System Message Styling */
.role-system.message-role {
    color: #f59e0b; /* Amber */
}
.role-system.message-content {
    border-left: thick #f59e0b;
    background: #451a03;
    color: #fef3c7;
    text-style: italic;
}

#message-list {
    height: 1fr;
}

#message-container {
    height: auto;
}

#work-widget {
    background: #1e293b;
    color: #f8fafc;
    border-bottom: solid #334155;
    margin: 0;
    padding: 0 1;
    height: auto;
}

.work-subpanel {
    background: transparent;
    color: #f8fafc;
    border: none;
    margin: 0;
    padding: 0;
    height: auto;
}

#background-tasks, #system-health {
    margin-top: 1;
}

LoadingIndicator {
    height: 3;
    margin: 1;
}

UserInput {
    dock: bottom;
    margin-top: 1;
    border: solid #0ea5e9;
    background: #0f172a;
}

UserInput:focus {
    border: double #38bdf8;
}

#modal-container {
    width: 80;
    height: auto;
    max-height: 30;
    border: double #ef4444;
    background: #1e293b;
    padding: 1 2;
    align: center middle;
}

#modal-actions-list {
    width: 100%;
    height: auto;
    max-height: 15;
    margin-bottom: 1;
    border: solid #334155;
    padding: 1;
    background: #0f172a;
}

.modal-action-item {
    width: 100%;
    color: #f8fafc;
    margin-bottom: 0;
}

#modal-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: #ef4444;
    margin-bottom: 1;
}

#modal-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#log-widget {
    background: #0f172a;
    color: #94a3b8;
    border-bottom: solid #334155;
    margin: 0;
    height: 1fr;
}

#log-title {
    width: 100%;
    background: #334155;
    color: #f8fafc;
    text-align: center;
    text-style: bold;
}

#log-content {
    padding: 1;
}

#log-scroll {
    height: 1fr;
}

/* Stopwatch and Timer Styles */
#work-stopwatch {
    border-bottom: solid #334155;
    margin: 0;
    padding: 0 1;
    height: auto;
}

#work-timer {
    margin: 0;
    padding: 0 1;
    height: auto;
}

.widget-header {
    height: 1;
    width: 100%;
    margin-top: 1;
}

.widget-title {
    width: auto;
    text-style: bold;
    color: #38bdf8; /* light blue */
}

.time-display {
    width: 1fr;
    text-align: right;
    text-style: bold;
    color: #f8fafc;
    background: #0f172a;
    padding: 0;
}

.controls-row, .presets-row {
    width: 100%;
    height: 1;
    align: center middle;
    margin-bottom: 0;
}

.controls-row Button, .presets-row Button {
    margin-left: 1;
    margin-right: 1;
    min-width: 5;
    height: 1;
    border: none;
    padding: 0 1;
}

#timer-input {
    width: 100%;
    height: 1;
    margin-top: 0;
    background: #0f172a;
    border: none;
    padding: 0;
}

#timer-input:focus {
    background: #1e293b;
}

.laps-display {
    width: 100%;
    background: #0f172a;
    color: #94a3b8;
    padding: 0;
    margin-top: 0;
    height: auto;
    max-height: 3;
}

/* Flash effect for active ringing timer */
.timer-ringing {
    border: double #ef4444 !important;
    background: #7f1d1d !important;
}

.timer-ringing .time-display {
    background: #7f1d1d !important;
    color: #ef4444 !important;
}
